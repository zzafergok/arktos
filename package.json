{
  "name": "arktos-monorepo",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,md,json}\"",
    "clean": "rm -rf node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "turbo": "^2.11.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=18.0.0"
  }
}
